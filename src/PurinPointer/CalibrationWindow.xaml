<Window x:Class="PurinPointer.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Paper}" Icon="Assets/PurinPointer.ico"
        FontFamily="{DynamicResource UiFont}" FontSize="13">
  <StackPanel Margin="22">
    <DockPanel>
      <TextBlock x:Name="ProgressText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" />
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
    </DockPanel>
    <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,10,0,14" />

    <!-- The pointer turns into the cursor being edited inside this pad. -->
    <Border x:Name="Pad" Height="320" CornerRadius="14" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
      <Canvas x:Name="PadCanvas" Background="Transparent" MouseLeftButtonDown="OnPadClick">
        <Grid x:Name="Target" Width="30" Height="30" IsHitTestVisible="False">
          <Ellipse Stroke="{DynamicResource Accent}" StrokeThickness="2" />
          <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" />
          <Rectangle Width="1" Height="30" Fill="{DynamicResource Accent}" Opacity="0.45" />
          <Rectangle Width="30" Height="1" Fill="{DynamicResource Accent}" Opacity="0.45" />
        </Grid>
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="ResultText" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock x:Name="NewHotspotText" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
      </Canvas>
    </Border>
    <TextBlock x:Name="WarningText" Foreground="{DynamicResource Warning}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />

    <DockPanel Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button IsCancel="True" Click="OnCancel" Margin="0,0,10,0"><TextBlock x:Name="CancelText" FontSize="12" /></Button>
        <Button x:Name="UseButton" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="OnUse">
          <TextBlock x:Name="UseText" FontSize="12" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" />
        </Button>
      </StackPanel>
      <Button HorizontalAlignment="Left" Click="OnAgain"><TextBlock x:Name="AgainText" FontSize="12" /></Button>
    </DockPanel>
  </StackPanel>
</Window>
