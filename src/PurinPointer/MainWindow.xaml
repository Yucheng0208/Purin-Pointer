<Window x:Class="PurinPointer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PurinPointer"
        Title="Purin Pointer" Width="1180" Height="880" MinWidth="1060" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Paper}" Icon="Assets/PurinPointer.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Microsoft YaHei UI, Yu Gothic UI, Malgun Gothic"
        FontSize="13">
  <Window.InputBindings>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{x:Static local:MainWindow.ApplyCommand}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static local:MainWindow.ApplyCommand}" Executed="OnApply" />
  </Window.CommandBindings>

  <Grid>
    <Grid x:Name="Root">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ── Sidebar ─────────────────────────────────────────────── -->
      <DockPanel Background="{DynamicResource Cream}">
        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Image Source="Assets/Logo.png" Width="42" Height="42" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="10,0,0,0">
              <TextBlock Text="Purin Pointer" FontSize="17" FontWeight="Bold" />
              <TextBlock x:Name="VersionText" FontSize="11" Foreground="{DynamicResource Muted}" />
            </StackPanel>
          </StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Border DockPanel.Dock="Right" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="2,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AddThemeButton" Style="{StaticResource IconButton}" Content="&#xE710;" Click="OnAddTheme" />
                <Border Width="1" Height="14" Background="{DynamicResource Divider}" />
                <Button x:Name="CopyThemeButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="OnCopyTheme" />
                <Border Width="1" Height="14" Background="{DynamicResource Divider}" />
                <Button x:Name="DeleteThemeButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnDeleteTheme" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="MyThemesText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
              <Border Background="{DynamicResource Pill}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ThemeCountText" FontSize="11" FontWeight="SemiBold" />
              </Border>
            </StackPanel>
          </DockPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
          <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,14" />
          <StackPanel x:Name="AutoSaveRow" Orientation="Horizontal" Margin="0,0,0,8" Background="Transparent">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
            <TextBlock x:Name="AutoSaveText" FontSize="12" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="AboutButton" Style="{StaticResource LinkButton}" Click="OnAbout"><TextBlock x:Name="AboutText" FontSize="11" Foreground="{DynamicResource Accent}" /></Button>
            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Muted}" />
            <Button Style="{StaticResource LinkButton}" Click="OnGitHub"><TextBlock Text="GitHub" FontSize="11" Foreground="{DynamicResource Accent}" /></Button>
            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Muted}" />
            <Button x:Name="UpdateButton" Style="{StaticResource LinkButton}" Click="OnCheckUpdates">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateText" FontSize="11" Foreground="{DynamicResource Accent}" Margin="4,0,0,0" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,0">
          <StackPanel x:Name="ThemeList" Margin="6,0" />
        </ScrollViewer>
      </DockPanel>

      <Border Grid.Column="1" Background="{DynamicResource Divider}" />

      <!-- ── Main ────────────────────────────────────────────────── -->
      <DockPanel Grid.Column="2" Margin="26">
        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="AppearanceButton" Style="{StaticResource MenuButton}" Click="OnOpenMenu">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="AppearanceText" Margin="6,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
              </StackPanel>
              <Button.ContextMenu><ContextMenu x:Name="AppearanceMenu" /></Button.ContextMenu>
            </Button>
            <Button x:Name="LanguageButton" Style="{StaticResource MenuButton}" Click="OnOpenMenu" Margin="6,0,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="LanguageText" Margin="6,0,4,0" VerticalAlignment="Center" />
                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
              </StackPanel>
              <Button.ContextMenu><ContextMenu x:Name="LanguageMenu" /></Button.ContextMenu>
            </Button>
          </StackPanel>
          <StackPanel>
            <TextBox x:Name="ThemeNameBox" FontSize="26" FontWeight="SemiBold" BorderThickness="0" Background="Transparent" Padding="0"
                     TextChanged="OnThemeNameChanged">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <ScrollViewer x:Name="PART_ContentHost" />
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>

        <!-- Mode tabs -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <UniformGrid x:Name="ModeTabs" Rows="1" />
          <ToggleButton x:Name="MoreButton" Grid.Column="1" Style="{StaticResource RowToggle}" Padding="14,9" Margin="8,0,0,0" Click="OnMoreClicked">
            <StackPanel Orientation="Horizontal">
              <Grid Width="32" Height="32">
                <local:AnimatedImage x:Name="MoreImage" Width="28" Height="28" />
                <TextBlock x:Name="MoreIcon" Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <TextBlock x:Name="MoreText" FontWeight="Medium" Margin="8,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
            </StackPanel>
            <ToggleButton.ContextMenu><ContextMenu x:Name="MoreMenu" Closed="OnMoreMenuClosed" /></ToggleButton.ContextMenu>
          </ToggleButton>
        </Grid>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,12" />
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="NativeButton" Click="OnRestoreNative" Margin="0,0,10,0" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                  <TextBlock x:Name="NativeText" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="UndoButton" Click="OnUndo" Margin="0,0,10,0" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                  <TextBlock x:Name="UndoText" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="OnApply" Padding="20,8">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource OnAccent}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ApplyText" Margin="6,0,0,0" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
              <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Muted}" Margin="10,0,16,0" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </StackPanel>

        <!-- Editor: the settings column scrolls on its own, the preview stays in view. -->
          <Border x:Name="EditorCard" CornerRadius="18" Padding="22,22,22,22" Background="{DynamicResource EditorCard}" Margin="0,0,0,18">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Left: import, size, hotspot, background -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-12,0">
              <StackPanel Margin="0,0,12,0">
                <DockPanel>
                  <Button x:Name="ClearButton" DockPanel.Dock="Right" Click="OnClearSlot" FontSize="12"><TextBlock x:Name="ClearText" FontSize="12" /></Button>
                  <TextBlock x:Name="ImportHeading" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,16,0,0" Height="156">
                  <Border x:Name="DropZone" CornerRadius="14" Background="{DynamicResource Cream}" AllowDrop="True"
                          DragEnter="OnDropZoneDragEnter" DragOver="OnDropZoneDragOver" DragLeave="OnDropZoneDragLeave" Drop="OnDropZoneDrop" />
                  <Rectangle RadiusX="14" RadiusY="14" Stroke="{DynamicResource Line}" StrokeThickness="1.2" StrokeDashArray="4 4" IsHitTestVisible="False" />
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="DropHint" FontSize="14" FontWeight="Medium" TextAlignment="Center" Margin="0,9,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="DropDetail" Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                      <Button Click="OnChooseFile" Padding="12,7"><TextBlock x:Name="ChooseText" /></Button>
                      <TextBlock x:Name="IntervalLabel" FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0" />
                      <ComboBox x:Name="IntervalBox" Width="96" SelectionChanged="OnIntervalChanged" />
                    </StackPanel>
                  </StackPanel>
                </Grid>

                <DockPanel Margin="0,16,0,0">
                  <Button x:Name="PathImportButton" DockPanel.Dock="Right" Margin="10,0,0,0" Click="OnImportPath"><TextBlock x:Name="ImportText" /></Button>
                  <Grid>
                    <TextBox x:Name="PathBox" TextChanged="OnPathChanged" KeyDown="OnPathKeyDown" />
                    <TextBlock x:Name="PathPlaceholder" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextWrapping="NoWrap" />
                  </Grid>
                </DockPanel>

                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16" />

                <DockPanel>
                  <TextBlock x:Name="SizeValue" DockPanel.Dock="Right" VerticalAlignment="Center" />
                  <TextBlock x:Name="SizeHeading" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Slider x:Name="SizeSlider" Minimum="32" Maximum="256" TickFrequency="16" IsSnapToTickEnabled="True" Margin="0,12,0,0"
                        ValueChanged="OnSizeSliding" PreviewMouseLeftButtonUp="OnSizeCommit" KeyUp="OnSizeCommit" />
                <DockPanel Margin="0,10,0,0">
                  <Button DockPanel.Dock="Left" Click="OnResetSize" FontSize="12" VerticalAlignment="Top"><TextBlock x:Name="ResetSizeText" FontSize="12" /></Button>
                  <TextBlock x:Name="SizeHint" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16" />

                <DockPanel>
                  <Button DockPanel.Dock="Right" Click="OnResetHotspot" x:Name="ResetHotspotButton"><TextBlock x:Name="ResetHotspotText" FontSize="12" /></Button>
                  <TextBlock x:Name="HotspotHeading" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid x:Name="HotspotInputs" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="X" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBox x:Name="HotXBox" Grid.Column="1" LostFocus="OnHotspotTyped" KeyDown="OnHotspotKey" />
                  <TextBlock Text="Y" Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0" />
                  <TextBox x:Name="HotYBox" Grid.Column="3" LostFocus="OnHotspotTyped" KeyDown="OnHotspotKey" />
                  <TextBlock Text="px" Grid.Column="4" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
                <TextBlock x:Name="HotspotHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />

                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,16" />

                <DockPanel>
                  <Button x:Name="RestoreOriginalButton" DockPanel.Dock="Right" Click="OnRestoreOriginal"><TextBlock x:Name="RestoreOriginalText" FontSize="12" /></Button>
                  <TextBlock x:Name="BackgroundHeading" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="BackgroundTools" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Click="OnAutoRemove" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock x:Name="AutoRemoveText" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <ToggleButton x:Name="WandToggle" Click="OnWandClicked">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock x:Name="WandText" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>
                <DockPanel x:Name="ToleranceRow" Margin="0,10,0,0">
                  <TextBlock x:Name="ToleranceLabel" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock x:Name="ToleranceValue" DockPanel.Dock="Right" FontSize="12" Width="28" TextAlignment="Right" VerticalAlignment="Center" />
                  <Slider x:Name="ToleranceSlider" Minimum="8" Maximum="160" Value="48" SmallChange="1" ValueChanged="OnToleranceChanged" />
                </DockPanel>
                <TextBlock x:Name="BackgroundHint" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                <TextBlock x:Name="ModeHint" Style="{StaticResource Hint}" Margin="0,14,0,0" />
              </StackPanel>
              </ScrollViewer>

              <!-- Right: preview -->
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" MinHeight="180" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                  <ToggleButton x:Name="ZoomToggle" DockPanel.Dock="Right" Click="OnZoomClicked" MinHeight="28" Padding="10,3">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="ZoomIcon" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                      <TextBlock x:Name="ActualSizeText" FontSize="11" Foreground="{DynamicResource Accent}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </ToggleButton>
                  <TextBlock x:Name="PreviewHeading" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="16" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" ClipToBounds="True">
                  <Grid>
                    <Border x:Name="PreviewChecker" CornerRadius="16" Background="{DynamicResource Checker}" Visibility="Collapsed" />
                    <TextBlock x:Name="NoCursorText" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                          MouseLeftButtonDown="OnPreviewDown" MouseMove="OnPreviewMove" MouseLeftButtonUp="OnPreviewUp">
                      <local:AnimatedImage x:Name="PreviewImage" Stretch="Fill" />
                      <Canvas x:Name="HotMarker" IsHitTestVisible="False">
                        <Path x:Name="HotCross" Stroke="{DynamicResource Accent}" StrokeThickness="1" />
                      </Canvas>
                    </Grid>
                  </Grid>
                </Border>
                <CheckBox x:Name="ShowHotspotBox" Grid.Row="2" Margin="0,14,0,0" IsChecked="True" Click="OnShowHotspotChanged">
                  <TextBlock x:Name="ShowHotspotText" FontSize="12" />
                </CheckBox>
                <TextBlock x:Name="PreviewHint" Grid.Row="3" Style="{StaticResource Hint}" Margin="0,10,0,0" />
              </Grid>
            </Grid>
          </Border>
      </DockPanel>
    </Grid>

    <!-- Busy overlay -->
    <Grid x:Name="BusyOverlay" Background="{DynamicResource Overlay}" Visibility="Collapsed">
      <Border Background="{DynamicResource Card}" CornerRadius="18" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}" BorderThickness="0" />
          <TextBlock x:Name="BusyText" Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
