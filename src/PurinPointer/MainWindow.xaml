<Window x:Class="PurinPointer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PurinPointer"
        Title="Purin Pointer" Width="1180" Height="780" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Paper}" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Microsoft YaHei UI, Yu Gothic UI, Malgun Gothic"
        FontSize="13" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{local:T lang.label}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" />
        <ComboBox x:Name="LanguageBox" Width="140" DisplayMemberPath="NativeName" SelectionChanged="OnLanguageChanged" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Purin Pointer" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}" />
        <TextBlock Text="{local:T app.subtitle}" Foreground="{StaticResource Muted}" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Pointer list -->
      <Border Style="{StaticResource CardBorder}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{local:T roles.header}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Click="OnApply">
              <TextBlock Text="{local:T action.apply}" Foreground="White" />
            </Button>
            <Button x:Name="UndoButton" Click="OnUndo">
              <TextBlock Text="{local:T action.undo}" />
            </Button>
            <Button Click="OnResetAll" Margin="0">
              <TextBlock Text="{local:T action.reset}" />
            </Button>
          </StackPanel>
          <ListBox x:Name="RoleList" BorderThickness="0" Background="Transparent" SelectionChanged="OnRoleSelected"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type local:RoleItem}">
                <Grid Margin="2,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="36" Height="36" CornerRadius="6" Background="{StaticResource Checker}">
                    <Image Source="{Binding Thumbnail}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0,6,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <Border Grid.Column="2" CornerRadius="9" Padding="8,2" VerticalAlignment="Center">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#F3EEE8" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Highlight}" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Accent}" TextWrapping="NoWrap" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Editor -->
      <Border Grid.Column="2" Style="{StaticResource CardBorder}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="330" />
          </Grid.ColumnDefinitions>

          <!-- Preview column -->
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="RoleTitle" FontSize="20" FontWeight="SemiBold" />
              <TextBlock x:Name="SourceInfo" Style="{StaticResource Hint}" Margin="0,2,0,10" />
              <StackPanel Orientation="Horizontal">
                <Button Click="OnBrowseFiles" Margin="0,0,8,0">
                  <TextBlock Text="{local:T import.browse}" />
                </Button>
                <Button Click="OnBrowseFolder" Margin="0">
                  <TextBlock Text="{local:T import.folder}" />
                </Button>
              </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
              <TextBlock Text="{local:T preview.actual}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Border Background="{StaticResource Checker}" CornerRadius="6" Padding="6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Image x:Name="ActualImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
              </Border>
            </StackPanel>

            <!-- Large preview: 320 × 320 px regardless of the cursor size -->
            <Border Margin="0,16,0,0" Width="340" Height="340" HorizontalAlignment="Left" VerticalAlignment="Top"
                    CornerRadius="10" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Checker}">
              <Grid Width="320" Height="320">
                <Image x:Name="PreviewImage" Width="320" Height="320" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Canvas x:Name="HotspotLayer" IsHitTestVisible="False">
                  <Line x:Name="HotH" Stroke="#E0563B" StrokeThickness="1" Opacity="0.85" />
                  <Line x:Name="HotV" Stroke="#E0563B" StrokeThickness="1" Opacity="0.85" />
                  <Ellipse x:Name="HotDot" Width="9" Height="9" Stroke="White" StrokeThickness="1.5" Fill="#E0563B" />
                </Canvas>
                <Border x:Name="ClickSurface" Background="Transparent" Cursor="Cross" MouseLeftButtonDown="OnPreviewClick" />
                <TextBlock x:Name="EmptyHint" Text="{local:T import.drop}" TextAlignment="Center" Margin="30"
                           VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False" />
              </Grid>
            </Border>
          </DockPanel>

          <!-- Settings column -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel x:Name="ProjectSettings">
              <TextBlock Text="{local:T section.size}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
              <DockPanel>
                <ComboBox x:Name="SizeBox" DockPanel.Dock="Right" Width="110" SelectionChanged="OnSizeChanged" />
                <TextBlock Text="{local:T size.canvas}" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Text="{local:T size.note}" Style="{StaticResource Hint}" Margin="0,8,0,10" />

              <TextBlock Text="{local:T section.hotspot}" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="{local:T hotspot.hint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{local:T hotspot.x}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="HotXBox" Width="60" Padding="4,3" LostFocus="OnHotspotTyped" KeyDown="OnHotspotKey" />
                <TextBlock Text="{local:T hotspot.y}" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="HotYBox" Width="60" Padding="4,3" LostFocus="OnHotspotTyped" KeyDown="OnHotspotKey" />
              </StackPanel>

              <TextBlock Text="{local:T section.speed}" Style="{StaticResource SectionTitle}" />
              <DockPanel>
                <TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="{local:T speed.label}" VerticalAlignment="Center" />
              </DockPanel>
              <Slider x:Name="SpeedSlider" Minimum="-2" Maximum="2" Value="0" TickFrequency="0.25" IsSnapToTickEnabled="True"
                      Margin="0,6,0,0" ValueChanged="OnSpeedChanged" />
              <TextBlock x:Name="StaticHint" Text="{local:T speed.static}" Style="{StaticResource Hint}" />

              <TextBlock Text="{local:T section.background}" Style="{StaticResource SectionTitle}" />
              <Button Click="OnRemoveEdge">
                <TextBlock Text="{local:T bg.auto}" />
              </Button>
              <ToggleButton x:Name="WandToggle" Padding="12,7" Margin="0,0,0,8" Checked="OnWandToggled" Unchecked="OnWandToggled">
                <TextBlock Text="{local:T bg.wand}" />
              </ToggleButton>
              <TextBlock x:Name="WandHint" Text="{local:T bg.wand.hint}" Style="{StaticResource Hint}" Visibility="Collapsed" Margin="0,0,0,8" />
              <DockPanel>
                <TextBlock x:Name="ToleranceValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
                <TextBlock Text="{local:T bg.tolerance}" />
              </DockPanel>
              <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="128" Value="24" Margin="0,6,0,8" ValueChanged="OnToleranceChanged" />
              <Button Click="OnRevertBackground">
                <TextBlock Text="{local:T bg.revert}" />
              </Button>

              </StackPanel>
              <Separator Margin="0,12" />
              <Button Click="OnClearRole">
                <TextBlock Text="{local:T action.clearRole}" />
              </Button>

              <TextBlock Text="{local:T system.size}" Style="{StaticResource SectionTitle}" />
              <DockPanel>
                <TextBlock x:Name="BaseSizeValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Text="32 – 256 px" Style="{StaticResource Hint}" VerticalAlignment="Center" />
              </DockPanel>
              <Slider x:Name="BaseSizeSlider" Minimum="32" Maximum="256" TickFrequency="16" IsSnapToTickEnabled="True"
                      Margin="0,6,0,0" ValueChanged="OnBaseSizeSliding" PreviewMouseLeftButtonUp="OnBaseSizeCommit" KeyUp="OnBaseSizeCommit" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,12,0,0" Foreground="{StaticResource Muted}" />
  </Grid>
</Window>
