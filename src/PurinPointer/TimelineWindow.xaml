<Window x:Class="PurinPointer.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Paper}" Icon="Assets/PurinPointer.ico"
        FontFamily="{DynamicResource UiFont}" FontSize="13">
  <StackPanel Margin="22">
    <DockPanel>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" />
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
    </DockPanel>
    <TextBlock x:Name="HintText" Style="{StaticResource Hint}" Margin="0,10,0,14" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="170">
        <StackPanel x:Name="FrameStrip" Orientation="Horizontal" Margin="4" />
      </ScrollViewer>
      <StackPanel Grid.Column="2">
        <Border Width="130" Height="130" CornerRadius="12" Background="{DynamicResource Checker}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
          <Image x:Name="PreviewImage" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock x:Name="PreviewLabel" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <DockPanel Margin="0,16,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button x:Name="CancelButton" IsCancel="True" Click="OnCancel" Margin="0,0,10,0"><TextBlock x:Name="CancelText" FontSize="12" /></Button>
        <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnCreate">
          <TextBlock x:Name="CreateText" FontSize="12" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold" />
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <Button Click="OnSort" Margin="0,0,10,0"><TextBlock x:Name="SortText" FontSize="12" /></Button>
        <Button Click="OnReverse" Margin="0,0,10,0"><TextBlock x:Name="ReverseText" FontSize="12" /></Button>
        <ComboBox x:Name="IntervalBox" Width="96" SelectionChanged="OnIntervalChanged" />
      </StackPanel>
    </DockPanel>
  </StackPanel>
</Window>
