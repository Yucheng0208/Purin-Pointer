<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark: pudding-inspired chocolate browns with custard yellow, caramel highlights and cream text. Colours match AniOnMac's adaptive palette (Studio.swift). -->
  <SolidColorBrush x:Key="Paper" Color="#2E2117" />        <!-- canvas: main background -->
  <SolidColorBrush x:Key="Cream" Color="#241A12" />        <!-- sidebar, drop zone -->
  <SolidColorBrush x:Key="Card" Color="#402E21" />         <!-- surface: cards, buttons -->
  <SolidColorBrush x:Key="Ink" Color="#FFF2D6" />
  <SolidColorBrush x:Key="Muted" Color="#C2B39A" />
  <SolidColorBrush x:Key="Accent" Color="#FAD66B" />
  <SolidColorBrush x:Key="AccentHover" Color="#D9FAD66B" />
  <SolidColorBrush x:Key="AccentPressed" Color="#E6B847" />
  <SolidColorBrush x:Key="OnAccent" Color="#3D2617" />
  <SolidColorBrush x:Key="AccentSoft" Color="#6B4729" /> <!-- apricot: hover / selection -->
  <SolidColorBrush x:Key="Hover" Color="#6B4729" />
  <SolidColorBrush x:Key="Pressed" Color="#8A5C33" />
  <SolidColorBrush x:Key="Selected" Color="#A66B4729" />
  <SolidColorBrush x:Key="Line" Color="#40FAD66B" />
  <SolidColorBrush x:Key="Custard" Color="#B3FAD66B" />
  <SolidColorBrush x:Key="Divider" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Field" Color="#1E1611" />
  <SolidColorBrush x:Key="Pill" Color="#A66B4729" />
  <SolidColorBrush x:Key="Overlay" Color="#80000000" />
  <SolidColorBrush x:Key="EditorCard" Color="#B3402E21" />  <!-- surface at 70 % -->
  <SolidColorBrush x:Key="Warning" Color="#E8912D" />
  <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#402E21" Geometry="M0,0 H2 V2 H0 Z" />
        <GeometryDrawing Brush="#4D3A2C" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
