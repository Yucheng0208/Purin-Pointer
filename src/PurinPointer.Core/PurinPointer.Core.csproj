<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral cursor logic: file formats, image processing, localisation.
       Kept free of WPF/Win32 so it can be built and tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PurinPointer.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" LogicalName="Strings.%(Filename).json" />
  </ItemGroup>
</Project>
